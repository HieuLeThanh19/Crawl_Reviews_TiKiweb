# .env.example — Sao chép thành .env và điền giá trị thực tế

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tiki_reviews
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Đổi thành chuỗi ngẫu nhiên bảo mật trong production:
API_SECRET_KEY=change-me-to-random-secret-key

# Google Gemini AI
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Crawler ──────────────────────────────────────────────────────────────────
CRAWL_DELAY=1.0
MAX_CONCURRENT=5
MAX_RETRIES=3
REQUEST_TIMEOUT=30

# ── NLP ──────────────────────────────────────────────────────────────────────
STOPWORDS_PATH=config/vietnamese_stopwords.txt
LDA_NUM_TOPICS=10

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
